# Copy to .env. The minutes room requires model credentials; the Bot has a labelled local demo.
# Optional minutes-room overrides (Responses API). Blank values reuse the compatible main provider.
MINUTES_API_KEY=
MINUTES_BASE_URL=
MINUTES_MODEL=
PORT=4317
HOST=127.0.0.1
LLM_PROVIDER=openai_next
NEXT_API_KEY=
NEXT_BASE_URL=https://api.openai-next.com/v1
NEXT_MODEL=gpt-5.6-terra
NEXT_REASONING_EFFORT=none
ASR_PROVIDER=next_omni
NEXT_ASR_MODEL=qwen3-omni-flash
SPEECH_PROVIDER=next_omni
NEXT_SPEECH_MODEL=qwen3-omni-flash
NEXT_SPEECH_VOICE=Ethan
NEXT_SPEECH_STYLE=温润、沉稳、克制的中青年男声，语速稍慢，吐字清楚，像谨慎有礼的古装医官，避免夸张和播音腔
# Optional alternatives: select the corresponding LLM/ASR/SPEECH provider explicitly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
# Local alternatives: ASR_PROVIDER=local, SPEECH_PROVIDER=windows.
WINDOWS_SPEECH_VOICE=Microsoft Huihui Desktop
QWEN_API_KEY=
# Choose the endpoint for the region in which your key was created.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DUI_PRODUCT_ID=
DUI_API_KEY=
DUI_BRANCH=prod
# SDK/device authorization: fill these, then run npm.cmd run dui:activate once.
DUI_PRODUCT_KEY=
DUI_PRODUCT_SECRET=
