{
  "name": "meeting-expert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "whisper:setup": "node scripts/setup-whisper.mjs",
    "whisper:vad": "node scripts/setup-whisper.mjs --vad-only",
    "whisper:quality": "node scripts/check-whisper-quality.mjs",
    "qwen:check": "node scripts/check-next-omni.mjs",
    "qwen:tts:check": "node scripts/check-next-omni-speech.mjs",
    "qwen:tts:configure": "node scripts/configure-next-omni-speech.mjs",
    "next:network": "node scripts/check-next-network.mjs",
    "local:check": "node scripts/check-local.mjs",
    "tts:check": "node scripts/check-windows-tts.mjs",
    "dui:activate": "node scripts/activate-dui.mjs",
    "generate:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-audio.ps1"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
